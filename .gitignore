# ==========================================
# ExamPro Comprehensive Git Ignore
# ==========================================

# 1. Environment & Credential Files
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key
*.pkcs12
*.jks

# 2. Build Outputs & Compiled Binaries
target/
*.class
*.jar
*.war
*.ear
frontend/dist/
frontend/dist-ssr/
*.tsbuildinfo

# 3. Dependencies
node_modules/
frontend/node_modules/
.pnp
.pnp.js

# 4. Logs & Temp Files
*.log
logs/
*.tmp
*.temp
test_*.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. IDE & Editor Specific Files
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.settings/
.classpath
.project
.metadata
bin/

# 6. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 7. Database Dumps & Backups
*.dump
*.dmp
*.bak
backup*.sql
dump*.sql
private*.sql

# Allow synthetic database definitions & demo seeds
!database/*.sql

# Local application configuration
application-local.properties
application-local.yml
application-local.yaml

# Database files
*.sqlite
*.sqlite3
*.db
