# ====================================================================
# ExamPro Backend Environment Variables Template
# Copy this file to .env for local development. Never commit real secrets to Git.
# ====================================================================

# Server Port (Render automatically sets $PORT; default is 8080 or 8081)
PORT=8081

# Database Connection
# For Local MySQL:
# DB_URL=jdbc:mysql://localhost:3306/exampro?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# For Cloud/Aiven MySQL (TLS Required):
# DB_URL=jdbc:mysql://<aiven-host>:<port>/<dbname>?sslMode=REQUIRED&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_URL=jdbc:mysql://localhost:3306/exampro?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=exampro_user
DB_PASSWORD=your_secure_database_password
DB_MAX_POOL_SIZE=5

# JWT Signing Secret (MUST be at least 32 characters / 256 bits of high-entropy key material)
# Generate a secure secret with: openssl rand -hex 32
JWT_SECRET=replace_with_at_least_32_bytes_of_random_secret_material
JWT_EXPIRATION_MS=3600000

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs)
# Local: http://localhost:3000
# Production on Vercel: https://your-exampro-frontend.vercel.app
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional Bootstrap Admin (Provisioned automatically on first startup if not already created)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_secure_admin_password_min_8_chars
ADMIN_NAME=ExamPro Administrator

# Spring Active Profile (use 'prod' for production on Render)
SPRING_PROFILES_ACTIVE=dev
